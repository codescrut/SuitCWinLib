<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy SuitCLib.dll from the solution build (build_dll.bat or Visual Studio, Release|x64). -->
    <None Include="..\SuitCLib\x64\Release\SuitCLib.dll" Link="SuitCLib.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\SuitCLib\x64\Release\SuitCLib.dll')" />
  </ItemGroup>

</Project>